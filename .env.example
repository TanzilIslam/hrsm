# Neon connection string (neon connection-string --project-id <id>)
DATABASE_URL=""

# Better Auth: generate a secret with `openssl rand -base64 32`
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# First Super Admin, created by `pnpm db:seed-admin` (min 10 character password)
ADMIN_NAME="Super Admin"
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Vercel Blob (image uploads). Connect a Blob store to the Vercel project and
# run `vercel env pull .env.local`, or paste the store's read-write token.
BLOB_READ_WRITE_TOKEN=""

# Inquiry email notifications (Resend). Without these, inquiries are still saved
# in the admin inbox; only the email is skipped.
RESEND_API_KEY=""
INQUIRY_NOTIFY_EMAIL=""
# Optional: a sender on a domain verified in Resend.
INQUIRY_FROM_EMAIL=""

# Public site URL (canonical links, sitemap). Use the real domain in production.
NEXT_PUBLIC_SITE_URL=""
# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX). Loaded in production only.
NEXT_PUBLIC_GA_ID=""
# Google Search Console HTML-tag verification token (optional).
NEXT_PUBLIC_GSC_VERIFICATION=""
